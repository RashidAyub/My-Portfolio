# =============================================
#  MIR Portfolio — Environment Variables
#  Copy to .env and fill in your values.
#  NEVER commit .env to version control.
# =============================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mir-portfolio?retryWrites=true&w=majority

# Server port (default 5000)
PORT=5000

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# ---- Nodemailer (optional email notifications) ----
# Gmail: enable "App Passwords" in Google Account > Security
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password
NOTIFY_EMAIL=your_gmail@gmail.com
